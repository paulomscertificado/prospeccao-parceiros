# =====================================================================
# Configuração do sistema de Prospecção de Parceiros
# Copie este arquivo para ".env" (o instalar.bat já faz isso) e preencha
# só o que for usar. Depois de mudar, feche e abra o sistema de novo.
# NUNCA envie o arquivo .env para ninguém: ele guarda suas chaves.
# =====================================================================

# --- Sistema ---------------------------------------------------------
# local (no seu computador) ou producao (servidor com HTTPS)
AMBIENTE=local
HOST=127.0.0.1
PORTA=8001
# Endereço público do sistema (usado no webhook do WhatsApp). Ex.: https://parceiros.mscertificados.com.br
URL_PUBLICA=http://localhost:8001
# Chaves de segurança. Se ficarem vazias, o sistema cria sozinho e guarda em dados/.
# Em produção, gere valores próprios (ver docs/deploy.md).
SECRET_KEY=
CHAVE_CRIPTOGRAFIA=
MINUTOS_SESSAO_OCIOSA=120

# --- Banco de dados --------------------------------------------------
# Vazio = SQLite em dados/banco.db (ideal para começar).
# PostgreSQL: postgresql+psycopg://usuario:senha@servidor:5432/prospeccao
DATABASE_URL=

# --- IA (Claude, da Anthropic) --------------------------------------
# Crie a chave em https://console.anthropic.com/ > API Keys
ANTHROPIC_API_KEY=
# claude-opus-5-5 (melhor qualidade), claude-sonnet-5-5 (equilíbrio) ou claude-haiku-5-5 (mais barato)
IA_MODELO=claude-opus-5-5

# --- Busca de escritórios -------------------------------------------
# Google Places API (New). Opcional: sem ela o sistema usa o OpenStreetMap (gratuito).
GOOGLE_PLACES_API_KEY=
# E-mail de contato exigido pela política de uso do OpenStreetMap
OSM_CONTATO=contato@mscertificados.com.br

# --- WhatsApp conectado pelo WhatsApp Leads (mesmo computador) -------
# Vazio = automático (lê o token de ../whatsapp-leads/dados/token_integracao.txt).
WHATSAPP_LEADS_URL=http://127.0.0.1:8000
WHATSAPP_LEADS_TOKEN=

# --- WhatsApp Cloud API (oficial da Meta) ---------------------------
# Opcional. Sem isso, use "Copiar mensagem" / "Abrir no WhatsApp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# "Chave secreta do app" (App Secret) no painel da Meta: confere a assinatura dos webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSAO=v21.0

# --- E-mail comercial (SMTP) ----------------------------------------
# Ex.: Google Workspace smtp.gmail.com porta 587 com "senha de app"
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=MS Certificação Digital <parcerias@mscertificados.com.br>
SMTP_TLS=1
SMTP_RESPONDER_PARA=
# O sistema só envia com remetente deste domínio (preencha pela tela Configurações > E-mail)
EMAIL_DOMINIO=mscertificados.com.br

# --- Respostas por e-mail (IMAP, opcional) ---------------------------
# A IA SDR lê as respostas dos leads nesta caixa (a mesma que envia), a cada 5 minutos.
IMAP_HOST=
IMAP_PORTA=993
IMAP_USUARIO=
IMAP_SENHA=

# --- Sistema na nuvem (Vercel) — ver docs/deploy-vercel.md ---------------
# A Vercel liga o modo nuvem sozinha (variável VERCEL). Para testar em outro servidor: MODO_NUVEM=1
# Senha do agendador que chama /api/cron a cada minuto (Vercel Cron manda "Authorization: Bearer CRON_SECRET")
CRON_SECRET=
# Segundos de trabalho por chamada do agendador (abaixo do maxDuration do vercel.json)
SEGUNDOS_POR_RODADA=240
# Senha da ponte com o WhatsApp Leads (a mesma do ligar_nuvem.bat do WhatsApp Leads)
WHATSAPP_PONTE_TOKEN=
# WHATSAPP_PONTE=1 usa a ponte mesmo fora da nuvem
