[Unit]
Description=Copia de seguranca diaria da Prospeccao (criptografada; o computador da MS baixa e manda para o Drive)
After=postgresql.service

[Service]
Type=oneshot
User=prospeccao
WorkingDirectory=/opt/prospeccao
EnvironmentFile=/etc/prospeccao/ambiente
Environment=PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/prospeccao/.venv/bin/python -W ignore fazer_backup.py --automatico
