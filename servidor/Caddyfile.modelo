# Site do sistema da MS (gerado pelo servidor/instalar_sistema.sh a partir de servidor/Caddyfile.modelo).
# O Caddy pede e renova sozinho o certificado (cadeado) para o endereço abaixo e para os antigos, que só levam
# para ele (instalar_sistema.sh <endereço> [endereços antigos...]).
__DOMINIO__ {
	encode zstd gzip
	# Outros serviços no mesmo endereço (ex.: /assinaturas* = validação online do Assinador MS, assinador-ms/servidor/)
	import /etc/caddy/extras/*.caddy
	reverse_proxy 127.0.0.1:8001
	log {
		output file /var/log/caddy/acesso.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
__REDIRECIONAMENTOS__