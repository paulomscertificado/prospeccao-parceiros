[Unit]
Description=Prospeccao de Parceiros (site)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=prospeccao
Group=prospeccao
WorkingDirectory=/opt/prospeccao
EnvironmentFile=/etc/prospeccao/ambiente
Environment=PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1
# api.index: a mesma entrada da Vercel (registro no journal). So escuta no proprio servidor: o Caddy recebe a internet.
ExecStart=/opt/prospeccao/.venv/bin/uvicorn api.index:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/prospeccao/dados

[Install]
WantedBy=multi-user.target
